{
  "name": "kia-customizer-radio-image-control",
  "version": "1.0.1",
  "description": "WordPress Customizer Radio Image Control",
  "main": "index.js",
  "scripts": {
    "build-css": "sass scss/style.scss css/style.css --style=compressed --no-source-map",
    "watch-css": "sass --watch scss/style.scss:css/style.css --style=compressed --no-source-map",
    "minify": "rm -f js/script.min.js && uglifyjs js/script.js --compress --mangle --warn --output js/script.min.js",
    "build": "npm run build-css && npm run minify"
  },
  "repository": {
    "type": "git",
    "url": "github.com/helgatheviking/customizer-radio-image-control"
  },
  "keywords": [
    "customizer",
    "wordpress",
    "control"
  ],
  "author": "helgatheviking",
  "license": "GPL-3.0",
  "devDependencies": {
    "sass": "^1.102.0",
    "uglify-js": "^3.19.3"
  }
}
